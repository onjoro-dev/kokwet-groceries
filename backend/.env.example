PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/kokwet-groceries
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
FREE_DELIVERY_THRESHOLD=3000
STANDARD_DELIVERY_FEE=150

# Daraja: use sandbox first, then production credentials from Safaricom.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS endpoint, e.g. https://api.example.com/api/orders/mpesa/callback
MPESA_CALLBACK_URL=
# Long random value; callback URL receives this in its token query parameter.
MPESA_CALLBACK_SECRET=
